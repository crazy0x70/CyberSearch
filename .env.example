# 至少配置一个付费/密钥供应商。DuckDuckGo 无需 key，默认始终启用。
TAVILY_API_KEY=
EXA_API_KEY=
BRAVE_API_KEY=
BRAVE_BASE_URL=https://api.search.brave.com
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev
TINYFISH_API_KEY=
TINYFISH_BASE_URL=https://api.search.tinyfish.ai
GROK_API_KEY=
GROK_MODEL=grok-4.6
GROK_BASE_URL=https://api.x.ai
GROK_TIMEOUT_SECONDS=180
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# 供应商顺序同时决定 fallback 顺序和 CyberFusion 同分时的稳定顺序。
CYBERSEARCH_PROVIDERS=tavily,exa,brave,firecrawl,tinyfish,grok,gemini,duckduckgo

# parallel: 并行查询并聚合；fallback: 顺序查询，首个有结果的供应商胜出。
CYBERSEARCH_MODE=parallel
CYBERSEARCH_TIMEOUT_SECONDS=30
CYBERSEARCH_DEFAULT_LIMIT=10
CYBERSEARCH_MAX_LIMIT=30
RUST_LOG=cybersearch=info

# 可选：自托管、代理或测试环境覆盖。
# TAVILY_BASE_URL=https://api.tavily.com
# EXA_BASE_URL=https://api.exa.ai
# DUCKDUCKGO_BASE_URL=https://html.duckduckgo.com

# 仅 HTTP Feature 使用。默认只监听 loopback。
CYBERSEARCH_HTTP_BIND=127.0.0.1:8080
